# =============================================================================
# Life Hub — environment template
#
# Copy this file to `.env.local` and fill in the real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real secrets. This template is
# the only env file that IS tracked, so it stays in sync with the app.
#
# Next.js loads `.env.local` automatically. drizzle-kit does NOT — which is
# why `drizzle.config.ts` loads it explicitly via `dotenv`.
# =============================================================================


# -----------------------------------------------------------------------------
# Clerk (authentication)
#
# Dev keys (no account needed, accountless mode):
#   npx -y clerk@latest init --no-skills
#
# Production keys (claim the app first):
#   npx -y clerk@latest auth login
#   npx -y clerk@latest env pull --instance prod
# -----------------------------------------------------------------------------

# Client-safe publishable key. Starts with pk_test_ / pk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side secret key. NEVER expose this to the browser.
# Starts with sk_test_ / sk_live_.
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk sends people. These must match the routes in `app/(auth)/`.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Where users land after signing in / up. Both fall back to the dashboard.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/


# -----------------------------------------------------------------------------
# Neon (database)
#
# Create a project at neon.com, then copy the POOLED connection string
# (Connection Details → Pooled connection). The pooled hostname contains
# "-pooler" — the app uses the HTTP driver, which needs the pooled endpoint.
#
# Apply the schema with:
#   npx drizzle-kit migrate
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.region.neon.tech/neondb?sslmode=require
